VITE_API_BASE_URL=/api

# Local Vite development server and API proxy; these are not browser variables.
DEV_CLIENT_HOST=localhost
DEV_CLIENT_PORT=5173
DEV_API_TARGET=http://localhost:5000

# Vercel platform settings only; do not prefix these with VITE_.
