NODE_ENV=development
PORT=5000
# Local Vite proxy only. Use 0 for a directly exposed production API.
# Numeric hop counts require a controlled proxy chain with no shorter bypass.
TRUST_PROXY=loopback
# Independent per-IP quotas. Window values are in milliseconds.
API_RATE_LIMIT_WINDOW_MS=60000
API_READ_RATE_LIMIT=300
API_WRITE_RATE_LIMIT=60
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_WRITE_RATE_LIMIT=20
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tech_ecommerce
REDIS_URL=redis://localhost:6379
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
CLIENT_ORIGIN=http://localhost:5173
ORDER_SHIPPING_FEE_VND=30000
ORDER_FREE_SHIPPING_THRESHOLD_VND=500000
ORDER_BANK_RESERVATION_MINUTES=30
ORDER_BANK_RECONCILIATION_SLA_HOURS=2
ORDER_COD_CONFIRMATION_HOURS=24
ORDER_MAX_PENDING_PER_CUSTOMER=3
# Assigned orders use their stored order waiting deadline for confirmation.
# Alert on orders waiting for initial assignment or shift handover.
ORDER_ASSIGNMENT_QUEUE_SLA_MINUTES=5
# Warn when a queued order is this close to its stock reservation deadline.
ORDER_ASSIGNMENT_DEADLINE_WARNING_MINUTES=10
# Comma-separated existing Better Auth user IDs. No account is created automatically.
ORDER_ADMIN_USER_IDS=
# All three fields must be configured to offer bank transfer at checkout.
ORDER_BANK_NAME=
ORDER_BANK_ACCOUNT_NUMBER=
ORDER_BANK_ACCOUNT_HOLDER=
